FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_JSON can be plain JSON or base64-encoded JSON.

# Alternative to FIREBASE_SERVICE_ACCOUNT_JSON:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Server-side admin identity. Must match client VITE_ADMIN_EMAIL.
# Set this in server/.env; the backend does not read client/.env.
ADMIN_EMAIL=

# Optional comma-separated allowlist for frontend origins in CORS
# Example: https://giftandsonsinternational.com,https://gift-and-sons.vercel.app
FRONTEND_ORIGINS=

# Cloudinary credentials (server-side only; never add these to client/.env)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=